<!--
    Colours of the 3D view. They are not part of the Precision palette, which only covers chrome, so
    they live here and the view reads them through PlotPalette.

    The deviation bands use the usual traffic-light meaning. Missed parts of the reference are
    magenta, so they never read as a run's own red. The ten file colours are for "colour by file"
    and for runs that have not been compared yet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PlotBackgroundColor">#FF14181D</Color>
    <Color x:Key="PlotReferenceColor">#FFE6EBF1</Color>
    <Color x:Key="PlotGridColor">#FF2F3842</Color>
    <Color x:Key="PlotHighlightColor">#FF37B6D8</Color>
    <!-- Issue numbers sit on a coloured tag, so their text is the dark ink the accent uses. -->
    <Color x:Key="PlotLabelTextColor">#FF07141A</Color>

    <Color x:Key="DeviationWithinColor">#FF3FBF7F</Color>
    <Color x:Key="DeviationNearColor">#FFF2B13A</Color>
    <Color x:Key="DeviationBeyondColor">#FFE5534B</Color>
    <Color x:Key="MissedColor">#FFD46BF2</Color>

    <Color x:Key="FileColor0">#FF4C9AFF</Color>
    <Color x:Key="FileColor1">#FFFF8B3D</Color>
    <Color x:Key="FileColor2">#FF2CC7B0</Color>
    <Color x:Key="FileColor3">#FFA884FF</Color>
    <Color x:Key="FileColor4">#FFFF6FAE</Color>
    <Color x:Key="FileColor5">#FFE8D44D</Color>
    <Color x:Key="FileColor6">#FF5AD1F0</Color>
    <Color x:Key="FileColor7">#FF9BD65A</Color>
    <Color x:Key="FileColor8">#FFFF7A6B</Color>
    <Color x:Key="FileColor9">#FFC3A6FF</Color>

    <!-- Brushes for the legend and the file swatches, so the 2D chrome shows the same colours. -->
    <SolidColorBrush x:Key="DeviationWithin" Color="{StaticResource DeviationWithinColor}" />
    <SolidColorBrush x:Key="DeviationNear" Color="{StaticResource DeviationNearColor}" />
    <SolidColorBrush x:Key="DeviationBeyond" Color="{StaticResource DeviationBeyondColor}" />
    <SolidColorBrush x:Key="Missed" Color="{StaticResource MissedColor}" />
    <SolidColorBrush x:Key="PlotReference" Color="{StaticResource PlotReferenceColor}" />

</ResourceDictionary>
