<UserControl x:Class="Compare3DTrajectory.App.Viewer.TrajectoryViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <Grid>
    <!-- Z is up: the working frame is East-North-Up. Turntable rotation keeps the ground level
         however far the view is dragged round. -->
    <hx:Viewport3DX x:Name="View"
                    BackgroundColor="{DynamicResource PlotBackgroundColor}"
                    ModelUpDirection="0,0,1"
                    CameraRotationMode="Turntable"
                    ShowViewCube="True"
                    ViewCubeHorizontalPosition="0.85"
                    ViewCubeVerticalPosition="0.8"
                    ShowCoordinateSystem="True"
                    CoordinateSystemHorizontalPosition="-0.85"
                    CoordinateSystemVerticalPosition="0.8"
                    CoordinateSystemLabelX="E"
                    CoordinateSystemLabelY="N"
                    CoordinateSystemLabelZ="U"
                    CoordinateSystemLabelForeground="{DynamicResource TextSecondaryColor}"
                    ZoomExtentsWhenLoaded="False"
                    ZoomAroundMouseDownPoint="True"
                    IsInertiaEnabled="True"
                    FXAALevel="Medium"
                    MouseMove="OnViewMouseMove"
                    MouseLeave="OnViewMouseLeave">
      <hx:Viewport3DX.Camera>
        <hx:PerspectiveCamera Position="0,-600,450"
                              LookDirection="0,600,-450"
                              UpDirection="0,0,1"
                              NearPlaneDistance="0.5"
                              FarPlaneDistance="5000000" />
      </hx:Viewport3DX.Camera>

      <!-- Drag with the left button to turn the view, with the right or middle to move it; the wheel
           zooms towards the pointer and a double-click makes the clicked point the centre. -->
      <hx:Viewport3DX.InputBindings>
        <MouseBinding Command="{x:Static hx:ViewportCommands.Rotate}" Gesture="LeftClick" />
        <MouseBinding Command="{x:Static hx:ViewportCommands.Pan}" Gesture="RightClick" />
        <MouseBinding Command="{x:Static hx:ViewportCommands.Pan}" Gesture="MiddleClick" />
        <MouseBinding Command="{x:Static hx:ViewportCommands.SetTarget}" Gesture="LeftDoubleClick" />
      </hx:Viewport3DX.InputBindings>

      <hx:GroupModel3D x:Name="SceneRoot" />
    </hx:Viewport3DX>

    <!-- Hover read-out. Drawn by WPF over the 3D surface rather than as a ToolTip, which would wait
         for the pointer to rest and then stay put while it moves along a line. -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="HoverCard"
              Visibility="Collapsed"
              MaxWidth="460"
              Background="{DynamicResource TooltipBackground}"
              BorderBrush="{DynamicResource TooltipBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
              Padding="9,6">
        <TextBlock x:Name="HoverText"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{DynamicResource TooltipForeground}"
                   TextWrapping="Wrap" />
      </Border>
    </Canvas>
  </Grid>
</UserControl>
