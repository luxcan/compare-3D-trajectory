<Window x:Class="Compare3DTrajectory.App.Shell.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAltBackground}"
        KeyDown="OnKeyDown"
        TextOptions.TextFormattingMode="Display">

  <!-- Drawn from the same palette as the rest of the app, which a Windows message box never could be.
       No title bar: the border is the surface, and dragging anywhere on it moves the dialog. -->
  <Border BorderBrush="{DynamicResource ControlBorder}"
          BorderThickness="1"
          Padding="22,20,22,18"
          MouseLeftButtonDown="OnDrag">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimary}" />
      <!-- A list of refused files can outgrow the screen, so the message scrolls past a height. -->
      <ScrollViewer Margin="0,8,0,0"
                    MaxHeight="420"
                    VerticalScrollBarVisibility="Auto"
                    Focusable="False">
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" />
      </ScrollViewer>
      <StackPanel x:Name="Buttons"
                  Margin="0,22,0,0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
