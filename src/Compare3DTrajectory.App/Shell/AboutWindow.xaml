<Window x:Class="Compare3DTrajectory.App.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Compare 3D Trajectory"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        Foreground="{DynamicResource TextPrimary}">

  <!-- The design handoff's About dialog, as PdfTool builds it. DataContext is an AboutInfo, set in the
       constructor. The title bar is the one Windows draws, turned dark like the main window's; the
       handoff draws its own only because HTML has no window frame to borrow. There is no Updates
       panel: this app has no releases page, and is built from the repository, not downloaded. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================== Identity ============================== -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,22,24,22">
      <Border Width="52"
              Height="52"
              VerticalAlignment="Top"
              Background="{DynamicResource AccentBackground}"
              CornerRadius="{DynamicResource ControlCornerRadius}">
        <TextBlock Text="3D"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentForeground}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <StackPanel Margin="15,1,0,0">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />

        <TextBlock Text="{Binding VersionAndBuild}"
                   FontSize="12.5"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,4,0,0" />

        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   HorizontalAlignment="Left"
                   LineHeight="20"
                   LineStackingStrategy="BlockLineHeight"
                   Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <!-- ============================== Footer ============================== -->
    <Border Grid.Row="1"
            Height="52"
            Padding="24,0"
            Background="{DynamicResource SurfaceAltBackground}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="0,1,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="12.5">
            <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding IssuesUrl}">
              <Run Text="Report an issue" />
            </Hyperlink>
          </TextBlock>

          <Rectangle Width="1"
                     Height="14"
                     Margin="10,0"
                     Fill="{DynamicResource Divider}" />

          <TextBlock FontSize="12.5">
            <Hyperlink Style="{StaticResource Link}" NavigateUri="{Binding RepositoryUrl}">
              <Run Text="View source" />
            </Hyperlink>
          </TextBlock>
        </StackPanel>

        <Button Content="Close"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                MinWidth="84"
                Padding="16,0"
                Margin="0"
                IsDefault="True"
                IsCancel="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
