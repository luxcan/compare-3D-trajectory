<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The executable is Compare3DTrajectory.exe; the ".App" suffix only names the project. -->
    <AssemblyName>Compare3DTrajectory</AssemblyName>
    <RootNamespace>Compare3DTrajectory.App</RootNamespace>
    <AssemblyTitle>Compare 3D Trajectory</AssemblyTitle>
    <!-- Shown by Windows on the file, and by the About window under the version. -->
    <Description>Checks simulation runs against the trajectory they were meant to follow, in 3D.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The About window says when this build was made, and the assembly is the only thing that can
         answer that truthfully: the version alone does not tell two builds of it apart. -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <!-- The single self-contained exe comes from Properties\PublishProfiles\win-x64.pubxml. -->

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compare3DTrajectory.Core\Compare3DTrajectory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compare3DTrajectory.App.Tests" />
  </ItemGroup>

</Project>
