<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces the single self-contained Compare3DTrajectory.exe, which needs no .NET install:

    dotnet publish src/Compare3DTrajectory.App -p:PublishProfile=win-x64

  Kept out of the project so ordinary Release builds stay framework-dependent: another application
  can then reference the project and gets the viewer's exe beside its own, in Release as in Debug.
  IncludeNativeLibrariesForSelfExtract is what keeps it to one file; the native libraries inside it
  are unpacked into %TEMP%\.net\Compare3DTrajectory the first time each build runs.
  PublishTrimmed stays off: WPF breaks under trimming.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The XML docs exist for IDE0005 at build time; nobody reads them next to a published exe. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
</Project>
